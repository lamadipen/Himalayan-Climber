{
  "name": "indie-game-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "tsc --noEmit",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview --project dev",
    "deploy:prod": "npm run build && firebase deploy --only hosting --project prod"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "firebase": "^10.7.0",
    "phaser": "^3.60.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.40.0",
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^1.0.0",
    "firebase-admin": "^13.8.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
