rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Summit share cards — authenticated write (generated on summit), public read
    match /share-cards/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024   // 2MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Game assets (sprites, audio, tilemaps) — read-only for clients
    match /assets/{allPaths=**} {
      allow read:  if true;
      allow write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
